src/m3_masking/artifacts/splits.json
# overlays on museum photographs
reports/figures/batch/
# overlays on Indus-Seal-Dataset images
reports/figures/strips/
reports/figures/read_*.png
reports/figures/detect_*.png
reports/figures/dbg_*.png
reports/review.html
reports/strip_review.html
reports/engine/real_examples/
*.zip

# ---- training debris ----
runs/**/train_batch*.jpg
runs/**/val_batch*.jpg

# ---- python / editor / os ----
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.DS_Store

